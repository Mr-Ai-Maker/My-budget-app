<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ميزانيتي</title>

<link rel="stylesheet" href="style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

<!-- ========================= -->
<!-- الصفحة الرئيسية -->
<!-- ========================= -->

<div id="home" class="page active">

<header class="app-header">

<h1>💰 ميزانيتي</h1>

<p>إدارة أموالك بطريقة ذكية</p>

</header>

<div class="cards">

<div class="card">

<h3>💵 الرصيد الحالي</h3>

<p id="homeBalance">0 ريال</p>

</div>

<div class="card">

<h3>📈 إجمالي الدخل</h3>

<p id="homeIncome">0 ريال</p>

</div>

<div class="card">

<h3>📉 إجمالي المصروفات</h3>

<p id="homeExpense">0 ريال</p>

</div>

<div class="card">

<h3>🌱 إجمالي الاستثمارات</h3>

<p id="homeInvest">0 ريال</p>

</div>

</div>

<div class="quick-actions">

<button onclick="showPage('history')">

➕ إضافة عملية

</button>

<button onclick="showPage('stats')">

📊 الإحصائيات

</button>

<button onclick="showPage('summary')">

💰 الملخص المالي

</button>

</div>

</div>

<!-- نهاية الصفحة الرئيسية -->

  <!-- ========================= -->
<!-- صفحة الملخص المالي -->
<!-- ========================= -->

<div id="summary" class="page">

<h2>💰 الملخص المالي</h2>

<div class="summary-box">

<div class="summary-item">

💵 إجمالي الدخل

<span id="incomeSummary">0 ريال</span>

</div>

<div class="summary-item">

📉 إجمالي المصروفات

<span id="expenseSummary">0 ريال</span>

</div>

<div class="summary-item">

🌱 إجمالي الاستثمارات

<span id="investSummary">0 ريال</span>

</div>

<div class="summary-item">

💰 الرصيد المتبقي

<span id="remainSummary">0 ريال</span>

</div>

</div>

<div class="budget-box">

<h3>🎯 الميزانية الشهرية</h3>

<input
type="number"
id="budgetInput"
placeholder="أدخل الميزانية الشهرية">

<button onclick="saveBudget()">

💾 حفظ الميزانية

</button>

<div class="budget-progress">

<div id="budgetBar"></div>

</div>

<p id="budgetText">

لم يتم تحديد ميزانية بعد.

</p>

</div>

</div>

<!-- نهاية صفحة الملخص -->

  <!-- ========================= -->
<!-- صفحة الإحصائيات -->
<!-- ========================= -->

<div id="stats" class="page">

    <h2>📊 الإحصائيات</h2>

    <div class="chart-container">

        <canvas id="financeChart"></canvas>

    </div>

</div>

<!-- ========================= -->
<!-- صفحة العمليات -->
<!-- ========================= -->

<div id="history" class="page">

    <h2>📝 إدارة العمليات</h2>

    <div class="add-box">

        <input
            type="text"
            id="description"
            placeholder="📝 اسم العملية">

        <input
            type="number"
            id="amount"
            placeholder="💰 المبلغ">

        <select id="type">

            <option value="income">
                📈 دخل
            </option>

            <option value="expense">
                📉 مصروف
            </option>

            <option value="investment">
                🌱 استثمار
            </option>

        </select>

        <button onclick="addTransaction()">

            ➕ إضافة العملية

        </button>

    </div>

    <hr>

    <input
        type="text"
        id="searchInput"
        placeholder="🔍 ابحث عن عملية..."
        onkeyup="filterTransactions()">

    <select
        id="filterType"
        onchange="filterTransactions()">

        <option value="all">
            جميع العمليات
        </option>

        <option value="income">
            📈 الدخل
        </option>

        <option value="expense">
            📉 المصروفات
        </option>

        <option value="investment">
            🌱 الاستثمارات
        </option>

    </select>

    <div id="historyList">

    </div>

</div>

  <!-- ========================= -->
<!-- صفحة الإعدادات -->
<!-- ========================= -->

<div id="settings" class="page">

    <h2>⚙️ الإعدادات</h2>

    <div class="settings-list">

        <button onclick="toggleDarkMode()">
            🌙 الوضع الليلي
        </button>

        <button onclick="exportPDF()">
            📄 تصدير PDF
        </button>

        <button onclick="exportExcel()">
            📊 تصدير Excel
        </button>

        <button onclick="backupData()">
            ☁️ نسخ احتياطي
        </button>

        <button onclick="restoreData()">
            📥 استعادة البيانات
        </button>

    </div>

</div>

<!-- ========================= -->
<!-- شريط التنقل السفلي -->
<!-- ========================= -->

<nav class="bottom-nav">

    <button onclick="showPage('home')">
        🏠
        <br>
        الرئيسية
    </button>

    <button onclick="showPage('summary')">
        💰
        <br>
        الملخص
    </button>

    <button onclick="showPage('stats')">
        📊
        <br>
        الإحصائيات
    </button>

    <button onclick="showPage('history')">
        📜
        <br>
        العمليات
    </button>

    <button onclick="showPage('settings')">
        ⚙️
        <br>
        الإعدادات
    </button>

</nav>

<script src="script.js"></script>

</body>

</html>

<!-- ========================= -->
<!-- شريط التنقل السفلي -->
<!-- ========================= -->

<nav class="bottom-nav">

    <button onclick="showPage('home')">
        🏠
        <span>الرئيسية</span>
    </button>

    <button onclick="showPage('summary')">
        💰
        <span>الملخص</span>
    </button>

    <button onclick="showPage('stats')">
        📊
        <span>الإحصائيات</span>
    </button>

    <button onclick="showPage('history')">
        📋
        <span>العمليات</span>
    </button>

    <button onclick="showPage('settings')">
        ⚙️
        <span>الإعدادات</span>
    </button>

</nav>

<script src="script.js"></script>

</body>

</html>

